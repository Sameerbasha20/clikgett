<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/order_details_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/clikgett_card_surface">

    <!-- Header App Bar -->
    <RelativeLayout
        android:id="@+id/title_lyt"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/clikgett_card_surface"
        android:elevation="1dp"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/back_img"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/arrow_left"
            app:tint="@color/clikgett_text_primary"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/orderid_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/back_img"
            android:layout_marginStart="8dp"
            android:text="Order Details"
            android:textColor="@color/clikgett_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Keep view1 for compatibility if referenced -->
    <View
        android:id="@+id/view1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/clikgett_divider" />

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/clikgett_surface_bg"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- 1. Customer & Order Summary Card -->
            <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/clikgett_card_stroke"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/clikgett_card_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Customer Name & Call Action -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/username_txt_title_linear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/callbackframe_lt"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/username_txt_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Customer"
                            android:textColor="@color/clikgett_text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/username_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Customer Name"
                            android:textColor="@color/clikgett_text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/phonenumber_img"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/baseline_phone_android_24"
                                app:tint="@color/clikgett_text_muted" />

                            <TextView
                                android:id="@+id/mobileno"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:visibility="gone"
                                android:text="Mobile" />

                            <TextView
                                android:id="@+id/setmobileno_txt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="--"
                                android:textColor="@color/clikgett_text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Prominent Call Button -->
                    <FrameLayout
                        android:id="@+id/callbackframe_lt"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/btn_primary_selector"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_call_white"
                            android:contentDescription="Call Customer" />
                    </FrameLayout>
                </RelativeLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/clikgett_divider" />

                <!-- Grid Details: Order ID, Amount, Payment, Timings -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Col 1: Order ID -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/orderid_img"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/orderid"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Order ID"
                            android:textColor="@color/clikgett_text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/setorderid_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="#--"
                            android:textColor="@color/clikgett_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Col 2: Amount -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <FrameLayout
                            android:id="@+id/orderamount_lyt"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/orderidamount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Amount"
                            android:textColor="@color/clikgett_text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/setorderamount_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="₹0.00"
                            android:textColor="@color/clikgett_green_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Col 3: Payment Method -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/paymentmethode_img"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/ordermethode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Payment"
                            android:textColor="@color/clikgett_text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/setpaymentmethode_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Online"
                            android:textColor="@color/clikgett_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Order Placed Timestamp Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/cal_img"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/baseline_keyboard_arrow_right_24"
                        app:tint="@color/clikgett_text_muted" />

                    <TextView
                        android:id="@+id/deliverytime_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Received: "
                        android:textColor="@color/clikgett_text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/setdeliverytime_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/clikgett_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Delivery Completed Time (Shown only when delivered) -->
                <LinearLayout
                    android:id="@+id/deleverdtime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/clikgett_green_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Delivered at: "
                        android:textColor="@color/clikgett_green_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/setdeviverytime_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/clikgett_green_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Shipping Address Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/clikgett_card_stroke"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/clikgett_card_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/orderdetails_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Delivery Destination"
                        android:textColor="@color/clikgett_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Prominent View Map Button -->
                    <TextView
                        android:id="@+id/viewmap_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/btn_primary_selector"
                        android:paddingHorizontal="14dp"
                        android:gravity="center"
                        android:text="View Map"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />
                </RelativeLayout>

                <!-- Address text with icon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/address_img"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_location"
                        app:tint="@color/clikgett_green_primary" />

                    <TextView
                        android:id="@+id/setaddress_txt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Address details..."
                        android:textColor="@color/clikgett_text_secondary"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>

                <!-- Distance and Payout Points -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/dis_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Distance: -- km"
                        android:textColor="@color/clikgett_green_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/earnpoints_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Earnings: -- rs"
                        android:textColor="@color/color_warning"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Delivery Actions (Report Delay / Issue) -->
        <LinearLayout
            android:id="@+id/operational_actions_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_report_delay"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_delay_selector"
                android:drawableStart="@drawable/ic_delay_clock"
                android:drawablePadding="8dp"
                android:paddingHorizontal="12dp"
                android:text="Report Delay"
                android:textAllCaps="false"
                android:textColor="@color/color_warning"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_report_issue"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_issue_selector"
                android:drawableStart="@drawable/ic_alert_triangle"
                android:drawablePadding="8dp"
                android:paddingHorizontal="12dp"
                android:text="Report Issue"
                android:textAllCaps="false"
                android:textColor="@color/color_danger"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Compatibility view2 and view3 -->
        <View
            android:id="@+id/view2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <View
            android:id="@+id/view3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- 4. Order Items Section -->
        <TextView
            android:id="@+id/orderslist_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="6dp"
            android:text="Items In This Order"
            android:textColor="@color/clikgett_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/orders_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <!-- 5. Milestone Interactive Sliders -->
        <com.ncorti.slidetoact.SlideToActView
            android:id="@+id/pickup_bt"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            app:text="Slide to Pick Up Order"
            app:text_size="15sp"
            app:inner_color="@color/white"
            app:outer_color="@color/clikgett_green_primary"
            app:icon="@drawable/baseline_keyboard_arrow_right_24" />

        <com.ncorti.slidetoact.SlideToActView
            android:id="@+id/arrived_btns"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            app:text="Slide to Mark Arrived"
            app:text_size="15sp"
            app:inner_color="@color/white"
            app:outer_color="#2563EB"
            app:icon="@drawable/baseline_keyboard_arrow_right_24" />

        <com.ncorti.slidetoact.SlideToActView
            android:id="@+id/delivered_bt"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            app:text="Slide to Complete Delivery"
            app:text_size="15sp"
            app:inner_color="@color/white"
            app:outer_color="@color/clikgett_green_primary"
            app:icon="@drawable/baseline_keyboard_arrow_right_24" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layt"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clikgett_surface_bg"
    android:orientation="vertical">

    <!-- Header: order number, status, the delivery steps and the promised time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_order_header"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/back_img"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_header_icon_btn"
                android:contentDescription="Back"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="9dp"
                android:src="@drawable/arrow_left"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/order_title_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Order"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/order_subtitle_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white_80"
                    android:textSize="12.5sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/status_chip_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:textColor="@color/clikgett_green_dark"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/steps_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <!-- When the customer expects the order -->
        <LinearLayout
            android:id="@+id/eta_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/eta_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Delivery time"
                android:src="@drawable/ic_delay_clock" />

            <TextView
                android:id="@+id/eta_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <!-- Cancelled / delivered -->
                <TextView
                    android:id="@+id/banner_txt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_card_surface"
                    android:backgroundTint="@color/color_danger_bg"
                    android:padding="14dp"
                    android:textColor="@color/color_danger"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Money: collect cash, or nothing to collect -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/payment_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:id="@+id/payment_inner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/payment_icon"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_header_icon_btn"
                            android:contentDescription="Payment"
                            android:padding="12dp"
                            android:src="@drawable/ic_baseline_currency_rupee_24"
                            app:tint="@color/white" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/payment_label_txt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.1"
                                android:text="COLLECT ON DELIVERY"
                                android:textColor="@color/white_80"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/collect_txt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="30sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/payment_detail_txt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white_80"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/payment_mode_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top"
                            android:background="@drawable/bg_chip_translucent"
                            android:letterSpacing="0.06"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Customer pays by UPI instead of cash: show a Razorpay QR -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/upi_btn"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Customer paying by UPI? Show QR"
                        android:textAllCaps="false"
                        android:textColor="@color/amber_text"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:backgroundTint="@color/white"
                        app:cornerRadius="14dp"
                        app:elevation="0dp"
                        app:icon="@drawable/ic_qr"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconSize="20dp"
                        app:iconTint="@color/amber_text" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Tip the customer added for the rider -->
                <TextView
                    android:id="@+id/tip_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_note_callout"
                    android:backgroundTint="@color/color_warning_bg"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:textColor="@color/clikgett_text_primary"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Customer and address -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/clikgett_card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/customer_initial_txt"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:gravity="center"
                                android:textColor="@color/white"
                                android:textSize="19sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:letterSpacing="0.08"
                                    android:text="CUSTOMER"
                                    android:textColor="@color/clikgett_text_muted"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/customer_name_txt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textColor="@color/clikgett_text_primary"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/customer_phone_txt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Customer"
                                    android:textColor="@color/clikgett_text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/call_btn"
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:contentDescription="Call customer"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                android:padding="0dp"
                                app:backgroundTint="@color/clikgett_green_primary"
                                app:cornerRadius="26dp"
                                app:elevation="0dp"
                                app:icon="@drawable/ic_call_white"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="22dp"
                                app:iconTint="@color/white" />
                        </LinearLayout>

                        <!-- Address -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_total_box"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:background="@drawable/bg_section_icon"
                                android:backgroundTint="@color/color_danger_bg"
                                android:contentDescription="Address"
                                android:padding="9dp"
                                android:src="@drawable/ic_location"
                                app:tint="@color/color_danger" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:letterSpacing="0.08"
                                    android:text="DELIVER TO"
                                    android:textColor="@color/clikgett_text_muted"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/address_txt"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:lineSpacingExtra="2dp"
                                    android:textColor="@color/clikgett_text_primary"
                                    android:textSize="14.5sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/instructions_box"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_note_callout"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="10dp"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="Note"
                                android:src="@drawable/ic_alert_triangle"
                                app:tint="@color/amber_text" />

                            <TextView
                                android:id="@+id/instructions_txt"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:textColor="@color/amber_text"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/navigate_btn"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="12dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:letterSpacing="0.01"
                            android:text="Navigate in Google Maps"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/clikgett_text_primary"
                            app:cornerRadius="16dp"
                            app:elevation="0dp"
                            app:icon="@drawable/ic_navigation_white"
                            app:iconGravity="textStart"
                            app:iconPadding="8dp"
                            app:iconSize="18dp"
                            app:iconTint="@color/white" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Items: photo, name, size and quantity; tap to tick off -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/items_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/clikgett_card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="16dp"
                        android:paddingBottom="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp">

                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:background="@drawable/bg_section_icon"
                                android:backgroundTint="@color/clikgett_green_light"
                                android:contentDescription="Items"
                                android:padding="9dp"
                                android:src="@drawable/ic_bag"
                                app:tint="@color/clikgett_green_dark" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/items_title_txt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Items"
                                    android:textColor="@color/clikgett_text_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/items_hint_txt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1dp"
                                    android:textColor="@color/clikgett_text_secondary"
                                    android:textSize="12.5sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/items_progress_txt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_qty_pill"
                                android:paddingStart="10dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="4dp"
                                android:textColor="@color/clikgett_green_dark"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/items_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Bill: how the total is made up -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/bill_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/clikgett_card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:background="@drawable/bg_section_icon"
                                android:backgroundTint="@color/color_delivery_bg"
                                android:contentDescription="Bill"
                                android:padding="9dp"
                                android:src="@drawable/ic_receipt"
                                app:tint="@color/color_delivery" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="Bill details"
                                android:textColor="@color/clikgett_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/bill_rows"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_total_box"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="14dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/bill_total_label_txt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/clikgett_text_primary"
                                    android:textSize="15.5sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/bill_total_hint_txt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/clikgett_text_secondary"
                                    android:textSize="12.5sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/bill_total_txt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/clikgett_text_primary"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Problems on the way -->
                <LinearLayout
                    android:id="@+id/problem_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="8dp"
                        android:letterSpacing="0.08"
                        android:text="NEED HELP WITH THIS ORDER?"
                        android:textColor="@color/clikgett_text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/delay_btn"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Report delay"
                            android:textAllCaps="false"
                            android:textColor="@color/amber_text"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/amber_bg"
                            app:cornerRadius="16dp"
                            app:elevation="0dp"
                            app:icon="@drawable/ic_delay_clock"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp"
                            app:iconSize="18dp"
                            app:iconTint="@color/amber_text" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/issue_btn"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Report problem"
                            android:textAllCaps="false"
                            android:textColor="@color/color_danger"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/color_danger_bg"
                            app:cornerRadius="16dp"
                            app:elevation="0dp"
                            app:icon="@drawable/ic_alert_triangle"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp"
                            app:iconSize="18dp"
                            app:iconTint="@color/color_danger" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- The one action for the current step: slide to confirm -->
    <LinearLayout
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_action_bar"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/step_hint_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:textColor="@color/clikgett_text_secondary"
            android:textSize="13sp" />

        <com.deliveryboy_clickget.SlideToActView
            android:id="@+id/action_btn"
            android:layout_width="match_parent"

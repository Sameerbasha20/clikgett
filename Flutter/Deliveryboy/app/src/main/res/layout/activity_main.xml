<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/clikgett_surface_bg"
    tools:openDrawer="start">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/clikgett_surface_bg">

        <!-- Top Operations App Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:paddingHorizontal="16dp"
            android:background="@color/clikgett_card_surface"
            android:elevation="1dp">

            <ImageView
                android:id="@+id/hamburger"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:onClick="nav_hambrg_drawer"
                android:src="@drawable/ic_menu"
                app:tint="@color/clikgett_text_primary"
                android:contentDescription="Navigation Menu" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/hamburger"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/app_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ClikGett Operations"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/clikgett_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delivery Partner Fleet"
                    android:textSize="11sp"
                    android:textColor="@color/clikgett_text_muted" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/duty_status_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:checked="false"
                app:thumbTint="@color/clikgett_green_primary"
                app:trackTint="#CBD5E1" />
        </RelativeLayout>

        <!-- Driver Telemetry & Overview Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/clikgett_card_stroke"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/clikgett_card_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/duty_status_badge"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Welcome back,"
                            android:textSize="12sp"
                            android:textColor="@color/clikgett_text_muted" />

                        <TextView
                            android:id="@+id/driver_greeting_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Driver Partner"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="@color/clikgett_text_primary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/duty_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="○ OFFLINE"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_offline"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:background="@drawable/bg_status_pill_offline" />
                </RelativeLayout>

                <!-- Subtle Separator -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/clikgett_divider" />

                <!-- Telemetry 3-column stats row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- GPS Indicator -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_gps_fixed"
                            app:tint="@color/clikgett_green_primary" />

                        <TextView
                            android:id="@+id/gps_status_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="GPS: Ready"
                            android:textSize="12sp"
                            android:textColor="@color/clikgett_text_secondary" />
                    </LinearLayout>

                    <!-- Battery Indicator -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_battery_std"
                            app:tint="@color/clikgett_green_primary" />

                        <TextView
                            android:id="@+id/battery_status_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Battery: --"
                            android:textSize="12sp"
                            android:textColor="@color/clikgett_text_secondary" />
                    </LinearLayout>

                    <!-- Today's Deliveries -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:gravity="center_vertical|end"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/clikgett_green_primary" />

                        <TextView
                            android:id="@+id/today_deliveries_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Today: 0 orders"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:textColor="@color/clikgett_green_primary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Segmented Orders Tabs -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layouts"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_tab_container"
            app:tabGravity="fill"
            app:tabMode="fixed"
            app:tabIndicator="@drawable/bg_segmented_indicator"
            app:tabIndicatorAnimationMode="elastic"
            app:tabIndicatorGravity="stretch"
            app:tabSelectedTextColor="@color/white"
            app:tabTextColor="@color/clikgett_text_secondary"
            app:tabRippleColor="@null" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <!-- Modern Drawer Navigation -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:background="@color/clikgett_card_surface"
        app:menu="@menu/nav_menu_items"
        app:itemTextColor="@color/clikgett_text_primary"
        app:itemIconTint="@color/clikgett_green_primary"
        app:itemIconPadding="14dp"
        android:layout_gravity="start"
        app:headerLayout="@layout/navigation_header_items" />

</androidx.drawerlayout.widget.DrawerLayout>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clikgett_surface_bg"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".SentotpActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Header / Logo Area -->
        <FrameLayout
            android:id="@+id/login_middle"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="32dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/bg_status_pill_online" />

            <ImageView
                android:id="@+id/login_middle_img"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:src="@drawable/baseline_phone_android_24"
                app:tint="@color/clikgett_green_primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/title_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Partner Login"
            android:textColor="@color/clikgett_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Enter your registered mobile number to proceed"
            android:textColor="@color/clikgett_text_secondary"
            android:textSize="14sp"
            android:gravity="center_horizontal" />

        <!-- Login Card Container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/clikgett_card_stroke"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/clikgett_card_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/emailid_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mobile Number"
                    android:textColor="@color/clikgett_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Input Card Container -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/emailid_cardview"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/clikgett_card_stroke"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#F8FAFC">

                    <EditText
                        android:id="@+id/phonenumber_edt"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:drawableStart="@drawable/ic_baseline_phone_iphone_24"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/clikgett_text_muted"
                        android:hint="Enter 10-digit mobile number"
                        android:imeOptions="actionDone"
                        android:inputType="phone"
                        android:paddingHorizontal="14dp"
                        android:maxLength="10"
                        android:textColor="@color/clikgett_text_primary"
                        android:textColorHint="@color/clikgett_text_muted"
                        android:textSize="15sp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Send OTP Action -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/sentotp_bt"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/btn_primary_selector"
                    android:text="Send OTP"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="ClikGett Fleet Operations • Quick Commerce"
            android:textColor="@color/clikgett_text_muted"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>

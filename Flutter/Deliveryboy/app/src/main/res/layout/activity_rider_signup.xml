<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/signup_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clikgett_surface_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <ImageButton
            android:id="@+id/signup_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/arrow_left" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/clikgett_green_light"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/clikgett_green_primary"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛵  Become a delivery partner"
                    android:textColor="@color/clikgett_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Takes about 2 minutes. We check every partner before the first delivery."
                    android:textColor="@color/clikgett_text_secondary"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="1. Apply    2. We verify    3. Start delivering"
                    android:textColor="@color/clikgett_green_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 1. Name -->
        <TextView style="@style/SignupStep" android:text="1  ·  Your full name" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/name_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="As on your Aadhaar card"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            android:textColorHint="@color/clikgett_text_secondary"
            app:boxBackgroundColor="@color/clikgett_card_surface"
            app:boxStrokeColor="@color/clikgett_green_primary"
            app:hintTextColor="@color/clikgett_green_primary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/name_edt"
                android:textColor="@color/clikgett_text_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="60" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 2. Mobile + OTP -->
        <TextView style="@style/SignupStep" android:text="2  ·  Mobile number" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/mobile_layout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="10-digit mobile number"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                android:textColorHint="@color/clikgett_text_secondary"
                app:boxBackgroundColor="@color/clikgett_card_surface"
                app:boxStrokeColor="@color/clikgett_green_primary"
                app:hintTextColor="@color/clikgett_green_primary"
                app:prefixText="+91 "
                app:prefixTextColor="@color/clikgett_text_primary">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/mobile_edt"
                android:textColor="@color/clikgett_text_primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:maxLength="10" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/send_otp_btn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="58dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:text="Send OTP"
                android:textAllCaps="false"
                android:letterSpacing="0"
                android:textColor="@color/clikgett_green_dark"
                app:backgroundTint="@color/clikgett_card_surface"
                app:cornerRadius="12dp"
                app:strokeColor="@color/clikgett_green_primary" />
        </LinearLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/otp_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="OTP sent to your number"
            android:visibility="gone"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            android:textColorHint="@color/clikgett_text_secondary"
            app:boxBackgroundColor="@color/clikgett_card_surface"
            app:boxStrokeColor="@color/clikgett_green_primary"
            app:hintTextColor="@color/clikgett_green_primary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/otp_edt"
                android:textColor="@color/clikgett_text_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="6" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 3-5. Photos -->
        <TextView style="@style/SignupStep" android:text="3  ·  Selfie" />
        <include android:id="@+id/selfie_tile" layout="@layout/item_signup_photo" />
        <TextView style="@style/SignupStep" android:text="4  ·  Aadhaar card (front)" />
        <include android:id="@+id/aadhaar_tile" layout="@layout/item_signup_photo" />
        <TextView style="@style/SignupStep" android:text="5  ·  Driving licence" />
        <include android:id="@+id/licence_tile" layout="@layout/item_signup_photo" />

        <!-- 6. Vehicle -->
        <TextView style="@style/SignupStep" android:text="6  ·  What will you deliver on?" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/vehicle_bike"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/clikgett_card_surface"
                app:strokeColor="@color/clikgett_card_stroke"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🛵" android:textSize="34sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Bike" android:textColor="@color/clikgett_text_primary" android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/vehicle_auto"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/clikgett_card_surface"
                app:strokeColor="@color/clikgett_card_stroke"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🛺" android:textSize="34sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Auto" android:textColor="@color/clikgett_text_primary" android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <TextView
            android:id="@+id/vehicle_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/color_danger"
            android:textSize="12sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/submit_btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/clikgett_green_primary"
            android:text="Submit application"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="🔒 Your documents are used only to verify you and are never shown to customers."
            android:textColor="@color/clikgett_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>

<carbon.widget.LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="270dp"
    android:layout_height="250dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    app:carbon_cornerRadiusTopStart="12dp"
    app:carbon_cornerRadiusTopEnd="12dp"
    app:carbon_cornerRadiusBottomEnd="12dp"
    app:carbon_cornerRadiusBottomStart="12dp"
    android:layout_marginLeft="15dp"
    android:layout_marginRight="15dp"
    app:carbon_strokeWidth="0.8dp"
    app:carbon_stroke="@color/carbon_grey_50"
    android:background="@color/carbon_white"
    android:orientation="vertical">


    <carbon.widget.LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:carbon_cornerRadius="10dp"
        android:background="@color/carbon_white"
        app:carbon_strokeWidth="0.8dp"
        app:carbon_stroke="@color/carbon_grey_50"
        android:orientation="vertical">




        <carbon.widget.EditText
            android:id="@+id/orderstatusEdt"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/montserrat_medium"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:hint="Please enter OrderStatus"
            android:gravity="top"
            android:paddingLeft="15dp"
            android:paddingTop="10dp"
            app:carbon_stroke="#333333"
            app:carbon_strokeWidth="0.8dp"
            app:carbon_cornerRadius="13dp"
            android:background="@android:color/transparent"
            android:textSize="15dp"/>

        <carbon.widget.Button
            android:id="@+id/submitbtn"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:background="#F7911E"
            app:carbon_rippleColor="@color/white"
            android:fontFamily="@font/montserrat_medium"
            android:text="Submit"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:carbon_cornerRadius="11dp" />
    </carbon.widget.LinearLayout>

</carbon.widget.LinearLayout>
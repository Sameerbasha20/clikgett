<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/clikgett_surface_bg"
    android:gravity="center"
    android:padding="20dp"
    tools:context=".NavigationActivity">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="3dp"
        app:strokeColor="@color/clikgett_card_stroke"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="@color/clikgett_card_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_status_pill_online">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_navigation_white"
                    app:tint="@color/clikgett_green_primary"
                    android:contentDescription="Navigation" />
            </FrameLayout>

            <TextView
                android:id="@+id/nav_title_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Turn-by-Turn Navigation"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/clikgett_text_primary" />

            <TextView
                android:id="@+id/nav_coords_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Destination: Loading..."
                android:textSize="14sp"
                android:textColor="@color/clikgett_text_secondary"
                android:gravity="center_horizontal" />

            <!-- Primary Action: Open in Maps -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_launch_gmaps"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:text="Start Navigation in Maps"
                android:textAllCaps="false"
                android:background="@drawable/btn_primary_selector"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Secondary Action: Call Customer -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_call_cust"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:text="Call Customer"
                android:textAllCaps="false"
                android:background="@drawable/btn_outline_selector"
                android:textColor="@color/clikgett_green_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Return Action -->
            <Button
                android:id="@+id/btn_back"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="Return to Order Details"
                android:textAllCaps="false"
                android:textColor="@color/clikgett_text_muted"
                android:textSize="14sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
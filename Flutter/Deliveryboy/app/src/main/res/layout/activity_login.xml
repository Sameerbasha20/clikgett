<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clikgett_surface_bg"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Header / Logo Area -->
        <FrameLayout
            android:id="@+id/login_middle"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="28dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/bg_status_pill_online" />

            <ImageView
                android:id="@+id/login_middle_img"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lock"
                app:tint="@color/clikgett_green_primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/title_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Partner Portal"
            android:textColor="@color/clikgett_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Sign in to your delivery partner account"
            android:textColor="@color/clikgett_text_secondary"
            android:textSize="14sp" />

        <!-- Login Credentials Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/clikgett_card_stroke"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/clikgett_card_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Email / Username -->
                <TextView
                    android:id="@+id/emailid_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email Address"
                    android:textColor="@color/clikgett_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/emailid_cardview"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/clikgett_card_stroke"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#F8FAFC">

                    <EditText
                        android:id="@+id/emaiid_edt"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:drawableStart="@drawable/ic_email"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/clikgett_text_muted"
                        android:hint="Enter email address"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/clikgett_text_primary"
                        android:textColorHint="@color/clikgett_text_muted"
                        android:textSize="15sp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Password -->
                <TextView
                    android:id="@+id/password_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Password"
                    android:textColor="@color/clikgett_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/password_cardview"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/clikgett_card_stroke"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#F8FAFC">

                    <EditText
                        android:id="@+id/password_edt"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:drawableStart="@drawable/ic_lock"
                        android:drawablePadding="12dp"
                        android:drawableTint="@color/clikgett_text_muted"
                        android:hint="Enter account password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/clikgett_text_primary"
                        android:textColorHint="@color/clikgett_text_muted"
                        android:textSize="15sp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Sign In Action -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/login_bt"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/btn_primary_selector"
                    android:text="Sign In"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>

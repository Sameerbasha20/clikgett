<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds: HTTPS only. Debug builds (and release builds made with
     CLIKGETT_ALLOW_CLEARTEXT=true) use network_security_config_dev.xml, which allows
     plain HTTP to the dev PC on the LAN. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

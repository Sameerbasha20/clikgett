# Android Studio related files
/local.properties
/.metadata
.gradle/
.android/
.cxx/
**/android/app/debug
**/android/app/profile
**/android/app/release

# Android build output
android/app/build/
android/.cxx/
android/.gradle/
android/app/src/debug/
android/app/src/profile/
android/app/src/release/

# iOS build output
ios/.generated/
ios/Pods/
ios/.symlinks/
ios/build/
ios/Flutter/.last_build_id
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec

# Xcode related files
xcuserdata/
*.xcworkspace
*.xcuserstate
*.xcscmblueprint
ios/Runner.xcworkspace/
ios/Runner.xcuserdatad/
ios/Runner.xcodeproj/project.xcworkspace/

# macOS build output
macos/.flutter-plugins/
macos/.flutter-plugins-dependencies
macos/build/

# Windows build output
windows/.flutter-plugins/
windows/.flutter-plugins-dependencies
windows/build/

# Linux build output
linux/.flutter-plugins/
linux/.flutter-plugins-dependencies
linux/build/

# Web build output
web/.dart_tool/
web/build/

# Package files
*.jar
*.aar
*.tar.gz

# Logs and crash reports
*.log
pubspec.lock
pubspec_overrides.yaml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db
Desktop.ini

# Editor backups and swap files
*.swp
*~
*.swo

# Unit test reports
TEST*.xml

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Miscellaneous
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/


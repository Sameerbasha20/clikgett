{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "create-react-app",
    "installCommand": "npm install --legacy-peer-deps",
    "buildCommand": "CI=false npm run build",
    "outputDirectory": "build",
    "rewrites": [
        { "source": "/api/:path*", "destination": "https://clikgett-backend.onrender.com/api/:path*" },
        { "source": "/media/:path*", "destination": "https://clikgett-backend.onrender.com/media/:path*" },
        { "source": "/health", "destination": "https://clikgett-backend.onrender.com/health" },
        { "source": "/(.*)", "destination": "/index.html" }
    ]
}

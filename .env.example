# =============================================================================
# ClikGett Local Development Environment Configuration (.env.example)
# Copy this file to .env.local or .env for local Docker Compose execution.
# NEVER commit production credentials or live API keys to this file.
# =============================================================================

# --- General Environment ---
NODE_ENV=development
COMPOSE_PROJECT_NAME=clikgett

# --- MySQL (Local Container) ---
MYSQL_ROOT_PASSWORD=clikgett_root_dev
MYSQL_DATABASE=clikgett-dev
MYSQL_USER=clikgett_user
MYSQL_PASSWORD=clikgett_dev_password
MYSQL_PORT=3306

# --- Backend Database Connection (Container-to-Container via service DNS) ---
DB_HOST=mysql
DB_PORT=3306
DB_USER=clikgett_user
DB_PASSWORD=clikgett_dev_password
DB_NAME=clikgett-dev
SECRET_KEY=local_clikgett_dev_jwt_secret_key_32chars_min!

# --- PostgreSQL (Migration Target Database) ---
POSTGRES_DB=clikgett_pg_dev
POSTGRES_USER=clikgett_pg_user
POSTGRES_PASSWORD=clikgett_pg_dev_password
POSTGRES_PORT=5433

# --- Redis (Cache & Session Store) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=clikgett_redis_dev_secret
REDIS_ENABLED=true

# --- MinIO (Local S3-Compatible Object Storage) ---
MINIO_ROOT_USER=clikgett_minio_admin
MINIO_ROOT_PASSWORD=clikgett_minio_pass123
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=clikgett_minio_admin
S3_SECRET_KEY=clikgett_minio_pass123
S3_BUCKET=clikgett-media

# --- Mailpit (Local SMTP & Email Inspection) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# --- Ports Exposed on Host ---
BACKEND_HOST_PORT=5001
ADMIN_HOST_PORT=3001

# --- Security & Auth Demo Overrides ---
ADMIN_2FA_DEMO_OTP=123456
ADMIN_2FA_FIXED_DEMO_OTP=123456
GOOGLE_APIKEY=local_mock_google_maps_key

# --- SMS (textspeed.in) ---
TEXTSPEED_APIKEY=replace_with_textspeed_api_key

# --- Scheduled jobs (abandoned-cart / win-back triggers) ---
# External schedulers call the trigger endpoints with header  x-cron-secret: <value>
CRON_SECRET=replace_with_long_random_string

# --- Database connection (MySQL container) ---
# Set DB_SSL=true and DB_SSL_CA to a CA bundle path only for a TLS-enabled MySQL server.
DB_SSL=false
DB_SSL_CA=
DB_POOL_SIZE=10

# --- Files (MinIO container, served by the backend at /media) ---
# Optional: absolute media address when the backend sits behind a domain,
# e.g. https://api.clikgett.com/media/. Empty = the address each client used.
PUBLIC_MEDIA_BASE_URL=

# --- New-order SMS alert to the store owner (10-digit mobile). Unset = no SMS in development.
ADMIN_ALERT_MOBILE=

# --- Wallet transaction type codes (Wallets.ContentType)
OrderPlace=3
OrderCancel=4

# --- Login codes (Backend/server/services/LoginOtp.js)
# 4 works with the apps already on the stores; switch to 6 once old versions are gone.
LOGIN_OTP_DIGITS=4
RIDER_OTP_DIGITS=4
# Store-review account: this number logs in with this fixed code and gets no SMS.
# Leave both empty to disable.
REVIEW_LOGIN_MOBILE=
REVIEW_LOGIN_OTP=

# --- Payments
# Razorpay Dashboard > Webhooks: URL https://<api-host>/api/payments/razorpay-webhook,
# event payment.captured. Unused captured payments are refunded after 30 minutes.
RAZORPAY_WEBHOOK_SECRET=

# --- Proxy and browser access
# Number of proxies in front of the backend (nginx/load balancer) so rate limits see real client IPs.
# Set it only when the backend is reachable through that proxy alone; otherwise clients can fake their IP.
TRUST_PROXY=
# Production: browser origins allowed to call the API, comma-separated (the admin site if it is on another domain).
CORS_ORIGINS=
